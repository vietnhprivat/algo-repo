               </rdf:li>
            </rdf:Seq>
         </xmpMM:History>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmp:CreateDate>2024-11-29T14:12:18+05:30</xmp:CreateDate>
         <xmp:ModifyDate>2024-11-29T22:26:44+05:30</xmp:ModifyDate>
         <xmp:MetadataDate>2024-11-29T22:26:44+05:30</xmp:MetadataDate>
         <xmp:CreatorTool>Adobe InDesign 19.3 (Macintosh)</xmp:CreatorTool>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:ieeecs="ns:bridgeqe.adobe.com/ieeecs/1.0/">
         <ieeecs:Author1Aff>City University London</ieeecs:Author1Aff>
         <ieeecs:Author1SName>Maiden</ieeecs:Author1SName>
         <ieeecs:Author1FName>Neil</ieeecs:Author1FName>
         <ieeecs:ArticleTitle>The Inhibited Analyst</ieeecs:ArticleTitle>
         <ieeecs:Abstract>Requirements analysts need to ask the right questions repeatedly. They need to be more inquisitive and know why people want things as well as what happens beforehand. This requires them to become less inhibited and keep asking questions until they and their stakeholders are satisfied with the answers.</ieeecs:Abstract>
         <ieeecs:SectionTitle>Requirements</ieeecs:SectionTitle>
         <ieeecs:PageRange>100-102</ieeecs:PageRange>
         <ieeecs:FirstPage>100</ieeecs:FirstPage>
         <ieeecs:ContentType>orig-research</ieeecs:ContentType>
         <ieeecs:Issue>6</ieeecs:Issue>
         <ieeecs:Volume>28</ieeecs:Volume>
         <ieeecs:Year>2011</ieeecs:Year>
         <ieeecs:Month>November/December</ieeecs:Month>
         <ieeecs:ISSN>0740-7459</ieeecs:ISSN>
         <ieeecs:Publisher>IEEE Computer Society</ieeecs:Publisher>
         <ieeecs:MagTitle>IEEE Software</ieeecs:MagTitle>
         <ieeecs:ArticleDisplay>True</ieeecs:ArticleDisplay>
         <ieeecs:InDDFilename>s6req</ieeecs:InDDFilename>
         <ieeecs:BuyMe>True</ieeecs:BuyMe>
         <ieeecs:ShowHTM>False</ieeecs:ShowHTM>
         <ieeecs:ShowPDF>True</ieeecs:ShowPDF>
         <ieeecs:IssueDisplay>False</ieeecs:IssueDisplay>
         <ieeecs:Keywords>software, software engineering, requirements, engineer, analysis, analyst, stakeholders, social modeling, modelling, questions</ieeecs:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:illustrator="http://ns.adobe.com/illustrator/1.0/">
         <illustrator:StartupProfile>Print</illustrator:StartupProfile>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
      </rdf:Description>
      <rdf:Description rdf:about=""
