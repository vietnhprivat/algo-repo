    {
      "type": "stat",
      "title": "Projected free disk in 7d — predict_linear()",
      "description": "predict_linear() fits the recent 6h trend of available bytes and extrapolates 7 days ahead — how Prometheus drives predictive 'disk will fill' alerting.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 29
      },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
