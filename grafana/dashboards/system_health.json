      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "predict_linear(ClickHouseAsyncMetrics_DiskAvailable_default[6h], 7*24*3600)",
          "instant": true,
          "range": false
        }
      ]
    },
