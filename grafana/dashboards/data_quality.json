          "rawSql": "SELECT toDate(timestamp_utc) AS time, countIf(value = 0) AS zero_values\nFROM algo.timeseries FINAL\nWHERE area = '${area}'\n  AND curve_name LIKE 'ENTSOE ${area} EnergyPrice %'\n  AND timestamp_utc >= now() - INTERVAL 30 DAY\nGROUP BY time\nORDER BY time",
          "refId": "A"
