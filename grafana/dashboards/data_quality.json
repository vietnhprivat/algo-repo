          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT day AS time, greatest(24 - observed_hours, 0) AS missing_hours\nFROM (\n  SELECT toDate(timestamp_utc) AS day, countDistinct(toHour(timestamp_utc)) AS observed_hours\n  FROM algo.timeseries FINAL\n  WHERE area = '${area}'\n    AND curve_name LIKE 'ENTSOE ${area} EnergyPrice %'\n    AND timestamp_utc >= now() - INTERVAL 30 DAY\n  GROUP BY day\n)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Missing Energy Price Hours",
      "type": "timeseries"
