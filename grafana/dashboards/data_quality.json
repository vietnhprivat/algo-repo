          "rawSql": "SELECT toStartOfHour(max(timestamp_utc)) AS time, curve_name AS metric, dateDiff('hour', max(timestamp_utc), now()) AS freshness_hours\nFROM algo.timeseries FINAL\nWHERE area = '${area}'\nGROUP BY curve_name\nORDER BY curve_name",
