      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT day AS time, table_name AS metric, row_count AS value\nFROM (\n  SELECT toDate(timestamp_utc) AS day, 'timeseries' AS table_name, count() AS row_count\n  FROM algo.timeseries FINAL\n  WHERE area = '${area}' AND timestamp_utc >= now() - INTERVAL 30 DAY\n  GROUP BY day\n  UNION ALL\n  SELECT toDate(timestamp_utc) AS day, 'forecasts' AS table_name, count() AS row_count\n  FROM algo.forecasts FINAL\n  WHERE area = '${area}' AND timestamp_utc >= now() - INTERVAL 30 DAY\n  GROUP BY day\n  UNION ALL\n  SELECT toDate(timestamp_utc) AS day, 'experiment_predictions' AS table_name, count() AS row_count\n  FROM algo.experiment_predictions AS ep FINAL\n  INNER JOIN algo.experiment_runs AS er FINAL ON ep.run_id = er.run_id\n  WHERE er.area = '${area}' AND timestamp_utc >= now() - INTERVAL 30 DAY\n  GROUP BY day\n)\nORDER BY time, metric",
          "refId": "A"
        }
      ],
      "title": "Daily Row Counts",
      "type": "timeseries"
    },
